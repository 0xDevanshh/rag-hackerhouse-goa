# Sarvam AI API key, used for speech-to-text (STT) in src/stt.py
SARVAM_API_KEY=your_sarvam_api_key_here

# Which generation backend src/generation.py uses: "groq" (default) or "anthropic"
LLM_PROVIDER=groq

# Groq API key (free tier), used by GroqProvider in src/generation.py
GROQ_API_KEY=your_groq_api_key_here

# Anthropic API key, used by AnthropicProvider (fallback/alternate) in src/generation.py
ANTHROPIC_API_KEY=your_anthropic_api_key_here
