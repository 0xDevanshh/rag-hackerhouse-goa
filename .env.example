# Sarvam AI API key, used for speech-to-text (STT) in src/stt.py
SARVAM_API_KEY=your_sarvam_api_key_here

# Which generation backend src/generation.py uses: "local", "groq", or "anthropic"
LLM_PROVIDER=groq

# The benchmark always uses local extractive generation unless explicitly set to "hosted".
BENCHMARK_GENERATION_MODE=fast

# Groq API key (free tier), used by GroqProvider in src/generation.py
GROQ_API_KEY=your_groq_api_key_here

# Anthropic API key, used by AnthropicProvider (fallback/alternate) in src/generation.py
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Origin allowed to call the FastAPI backend (src/api.py) via CORS, e.g. the Next.js dev server
ALLOWED_ORIGIN=https://rag-hackerhouse-goa-sh3s.onrender.com

# Latency and startup controls
RAG_TARGET_MS=200
LLM_PREWARM_TIMEOUT_SECONDS=5
